---
import { t, type Lang } from '../lib/i18n';

/**
 * Shiriti i besimit: katër arsyet praktike për të porositur këtu.
 * Rri menjëherë poshtë hero-s, ku syri shkon pas titullit.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const items = [
  {
    title: t(lang, 'trustOrderTitle'),
    note: t(lang, 'trustOrderNote'),
    icon: 'chat',
  },
  {
    title: t(lang, 'trustPayTitle'),
    note: t(lang, 'trustPayNote'),
    icon: 'wallet',
  },
  {
    title: t(lang, 'trustDeliveryTitle'),
    note: t(lang, 'trustDeliveryNote'),
    icon: 'truck',
  },
  {
    title: t(lang, 'trustAdviceTitle'),
    note: t(lang, 'trustAdviceNote'),
    icon: 'heart',
  },
];

const paths: Record<string, string> = {
  chat: 'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z',
  wallet: 'M20 12V8H6a2 2 0 0 1 0-4h12v4M4 6v12a2 2 0 0 0 2 2h14v-4M18 12a2 2 0 0 0 0 4h4v-4z',
  truck: 'M1 3h15v13H1zM16 8h4l3 3v5h-7zM5.5 18.5a2.5 2.5 0 1 0 0 .01M18.5 18.5a2.5 2.5 0 1 0 0 .01',
  heart: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8z',
};
---

<section class="border-y border-mist bg-cream" aria-label={t(lang, 'whatWeStock')}>
  <div class="mx-auto max-w-[1200px] px-4 py-8 sm:py-10">
    <ul class="grid grid-cols-2 gap-x-5 gap-y-7 lg:grid-cols-4 lg:gap-x-8">
      {
        items.map((item) => (
          <li class="flex items-start gap-3" data-reveal>
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white ring-1 ring-gold-100">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-gold-500)"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={paths[item.icon]} />
              </svg>
            </span>

            <span class="min-w-0">
              <span class="block text-[15px] font-medium text-forest-900">
                {item.title}
              </span>
              <span class="mt-0.5 block text-[13px] leading-snug text-slate">
                {item.note}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

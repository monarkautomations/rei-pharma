---
/**
 * Filtri i çmimit për listat e produkteve.
 *
 * Punon mbi kartat që janë tashmë në HTML: nuk kërkon asgjë nga serveri dhe
 * nuk e ndryshon adresën. Rregulli 1 i projektit kërkon që përmbajtja të
 * lexohet pa JavaScript — dhe ashtu është: pa skript, filtri nuk shfaqet fare
 * dhe të gjitha produktet mbeten të dukshme.
 *
 * Numrat pranë çdo intervali llogariten këtu, në build, nga produktet e asaj
 * faqeje. Kovat pa asnjë produkt nuk shfaqen: një filtër që jep zero rezultate
 * vetëm zë vend.
 */
import { formatPrice, priceBuckets } from '../config/site';
import { t, type Lang } from '../lib/i18n';

interface Props {
  /** Çmimet e produkteve që ndodhen te kjo faqe. */
  prices: number[];
  lang: Lang;
}

const { prices, lang } = Astro.props;

const brenda = (cmimi: number, min?: number, max?: number) =>
  (min === undefined || cmimi >= min) && (max === undefined || cmimi < max);

const kovat = priceBuckets
  .map(({ min, max }) => ({
    min,
    max,
    count: prices.filter((c) => brenda(c, min, max)).length,
    // Njësia një herë, në fund: "1000 – 1500 L", jo "1000 L – 1500 L".
    label:
      min === undefined
        ? `${t(lang, 'priceUnder')} ${formatPrice(max!)}`
        : max === undefined
          ? `${t(lang, 'priceOver')} ${formatPrice(min)}`
          : `${formatPrice(min).replace(/\s*L$/, '')} – ${formatPrice(max)}`,
  }))
  .filter((k) => k.count > 0);

// Me një kovë të vetme s'ka çfarë të filtrosh: të gjitha produktet janë brenda
// saj, dhe filtri do të ishte një buton që nuk bën asgjë.
const vlen = kovat.length > 1;
---

{
  vlen && (
    <div class="mt-4" data-price-filter hidden>
      {/*
        Listë zgjedhëse, jo butona: intervalet janë pesë dhe, bashkë me filtrat
        e kategorive që rrinë sipër, do të bënin dy rreshta të tërë butonash në
        telefon. Kështu zë një rresht dhe tregon vetëm atë që është zgjedhur.

        `<select>` i vërtetë, jo menu e ndërtuar me div-a: në telefon hap
        zgjedhësin e vetë sistemit, punon me tastierë dhe me lexues ekrani pa
        i shkruar ne ato sjellje.
      */}
      <label class="inline-flex items-center gap-2">
        <span class="text-[14px] text-slate">{t(lang, 'filterByPrice')}</span>

        <span class="relative inline-flex">
          <select
            data-price-select
            class="min-h-[44px] appearance-none rounded-full border border-mist bg-white py-2 pr-10 pl-5 text-[14px] text-forest-900 transition-colors hover:border-gold-500 focus:border-forest-900 focus:outline-none"
          >
            <option value="">{t(lang, 'priceAll')}</option>
            {kovat.map((k) => (
              <option value={`${k.min ?? ''}:${k.max ?? ''}`}>
                {k.label} ({k.count})
              </option>
            ))}
          </select>

          {/* Shigjeta jonë, sepse `appearance-none` e heq atë të sistemit. */}
          <svg
            class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-slate"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </span>
      </label>
    </div>
  )
}

{
  vlen && (
    <p class="mt-8 text-[16px] text-graphite" data-price-empty hidden>
      {t(lang, 'noMatches')}{' '}
      <button
        type="button"
        data-price-clear
        class="text-gold-600 underline underline-offset-2 hover:text-forest-900"
      >
        {t(lang, 'clearFilter')}
      </button>
    </p>
  )
}

<script>
  /**
   * Fsheh e shfaq kartat sipas çmimit të zgjedhur.
   *
   * Filtri rri me `hidden` te HTML-ja dhe hapet vetëm këtu: nëse ky skript nuk
   * niset, vizitori nuk sheh një listë që nuk bën asgjë — sheh të gjitha
   * produktet, që është gjendja e saktë.
   */
  const filtri = document.querySelector<HTMLElement>('[data-price-filter]');
  const zgjedhesi = document.querySelector<HTMLSelectElement>('[data-price-select]');
  const kartat = Array.from(document.querySelectorAll<HTMLElement>('article[data-price]'));

  if (filtri && zgjedhesi && kartat.length > 0) {
    const bosh = document.querySelector<HTMLElement>('[data-price-empty]');
    const numeruesi = document.querySelector<HTMLElement>('[data-product-count]');

    filtri.hidden = false;

    const filtro = () => {
      // Vlera vjen si "min:max"; secila anë mund të mungojë.
      const [min, max] = zgjedhesi.value.split(':');
      const nga = min ? Number(min) : null;
      const deri = max ? Number(max) : null;

      let dukshme = 0;
      for (const karta of kartat) {
        const cmimi = Number(karta.dataset.price);
        const brenda = (nga === null || cmimi >= nga) && (deri === null || cmimi < deri);
        // Fshihet vetë karta, jo mbështjellësi: te disa faqe karta rri brenda
        // një div-i që mban animacionin, dhe grid-i do të linte vend bosh.
        karta.style.display = brenda ? '' : 'none';
        if (brenda) dukshme++;
      }

      if (bosh) bosh.hidden = dukshme > 0;
      if (numeruesi) {
        const fjala = numeruesi.dataset.many ?? '';
        numeruesi.textContent = `${dukshme} ${fjala}`;
      }
    };

    zgjedhesi.addEventListener('change', filtro);

    document.querySelector('[data-price-clear]')?.addEventListener('click', () => {
      zgjedhesi.value = '';
      filtro();
    });
  }
</script>

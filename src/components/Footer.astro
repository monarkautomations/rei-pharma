---
import { site } from '../config/site';
import { getCategoriesWithProducts } from '../lib/catalog';
import { path, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const year = new Date().getFullYear();
const categories = await getCategoriesWithProducts(lang);
const tel = `tel:${site.phone.replace(/\s/g, '')}`;

const links = [
  { href: path(lang, 'products'), label: t(lang, 'allProductsLink') },
  { href: path(lang, 'blog'), label: t(lang, 'navBlog') },
  { href: path(lang, 'about'), label: t(lang, 'navAbout') },
  { href: path(lang, 'contact'), label: t(lang, 'navContact') },
];
---

<footer class="mt-24 bg-forest-950 text-bone">
  <div class="mx-auto max-w-[1200px] px-4 py-14 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] lg:gap-10">
      <div>
        <img
          src="/logo-lockup-light.png"
          alt={site.brandName}
          width="579"
          height="132"
          loading="lazy"
          class="h-10 w-auto"
        />
        <p class="mt-5 max-w-xs text-[15px] leading-relaxed text-bone/70">
          {site.tagline[lang]}. {t(lang, 'footerTagline')}
        </p>

        <div class="rule-gold mt-6 h-px w-24"></div>
      </div>

      <nav aria-labelledby="footer-kategorite">
        <h2
          id="footer-kategorite"
          class="font-sans text-[13px] font-medium tracking-[0.14em] text-gold-300 uppercase"
        >
          {t(lang, 'categories')}
        </h2>
        <ul class="mt-3">
          {
            categories.map((c) => (
              <li>
                <a
                  href={path(lang, 'category', c.slug)}
                  class="flex min-h-[44px] items-center text-[15px] text-bone/80 transition-colors hover:text-gold-300"
                >
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-faqet">
        <h2
          id="footer-faqet"
          class="font-sans text-[13px] font-medium tracking-[0.14em] text-gold-300 uppercase"
        >
          {t(lang, 'pages')}
        </h2>
        <ul class="mt-3">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="flex min-h-[44px] items-center text-[15px] text-bone/80 transition-colors hover:text-gold-300"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-sans text-[13px] font-medium tracking-[0.14em] text-gold-300 uppercase">
          {t(lang, 'findUsHere')}
        </h2>

        <ul class="mt-3">
          <li>
            <a
              href={site.address.mapsUrl}
              target="_blank"
              rel="noopener"
              class="flex min-h-[44px] items-center gap-2.5 text-[15px] text-bone/80 transition-colors hover:text-gold-300"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              {site.address.street}, {site.address.city}
            </a>
          </li>
          <li>
            <a
              href={tel}
              class="flex min-h-[44px] items-center gap-2.5 text-[15px] text-bone/80 transition-colors hover:text-gold-300"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              {site.phone}
            </a>
          </li>
        </ul>

        <dl class="mt-4 space-y-1.5 text-[14px]">
          {
            site.hours.map((h) => (
              <div class="flex justify-between gap-4">
                <dt class="text-bone/60">{h.days[lang]}</dt>
                <dd class="tabular-nums text-bone/85">{h.open} – {h.close}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <p
      class="mt-12 rounded-md border border-bone/15 px-4 py-3 text-[13px] leading-relaxed text-bone/55"
    >
      {t(lang, 'legalNotice')}
    </p>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-bone/15 pt-6 text-[13px] text-bone/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.legalName}</p>
      <div class="flex flex-wrap gap-x-6">
        <a href={path(lang, 'privacy')} class="inline-flex min-h-[44px] items-center hover:text-gold-300">
          {t(lang, 'privacy')}
        </a>
        <a href={path(lang, 'terms')} class="inline-flex min-h-[44px] items-center hover:text-gold-300">
          {t(lang, 'terms')}
        </a>
      </div>
    </div>
  </div>
</footer>

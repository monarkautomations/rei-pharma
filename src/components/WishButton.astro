---
/**
 * Zemra që ruan një produkt te lista e dëshirave.
 *
 * Rri e fshehur derisa skripti të niset. Arsyeja është e njëjta si te filtri i
 * çmimit: pa JavaScript ajo do të ishte një zemër që nuk bën asgjë, dhe një
 * buton i vdekur është më keq se mungesa e tij.
 *
 * Skripti shkruhet një herë për faqe edhe kur komponenti përsëritet — Astro i
 * bashkon `<script>`-et e njëjta. Prandaj ai i lidh të gjitha zemrat me
 * `querySelectorAll`, jo vetëm të vetën.
 */
import { t, type Lang } from '../lib/i18n';

interface Props {
  slug: string;
  name: string;
  lang: Lang;
  /** `card` — rreth i vogël mbi foto. `full` — buton me tekst te faqja e produktit. */
  variant?: 'card' | 'full';
}

const { slug, name, lang, variant = 'card' } = Astro.props;
---

{
  variant === 'card' ? (
    <button
      type="button"
      data-wish={slug}
      aria-pressed="false"
      aria-label={`${t(lang, 'wishAdd')} — ${name}`}
      hidden
      class="absolute top-2 right-2 z-10 grid h-11 w-11 place-items-center rounded-full bg-white/90 text-forest-900 backdrop-blur-sm transition-colors hover:bg-white aria-pressed:text-alert"
    >
      {/*
        `fill` ndryshon me gjendjen: bosh kur s'është ruajtur, e mbushur kur po.
        Vetëm ngjyra nuk mjafton — dikush që s'i dallon ngjyrat do të shihte dy
        zemra të njëjta.
      */}
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 0 0 0-7.8z" />
      </svg>
    </button>
  ) : (
    <button
      type="button"
      data-wish={slug}
      aria-pressed="false"
      hidden
      class="mt-3 inline-flex w-full min-h-[46px] max-w-sm items-center justify-center gap-2 rounded-full border border-forest-900/20 px-6 text-[15px] font-medium transition-colors hover:bg-bone aria-pressed:border-alert/40 aria-pressed:text-alert"
    >
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 0 0 0-7.8z" />
      </svg>
      <span data-wish-label>{t(lang, 'wishAdd')}</span>
    </button>
  )
}

<script>
  import { eKa, nderro, degjo } from '../lib/wishlist';

  const zemrat = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-wish]'));

  if (zemrat.length > 0) {
    // Fjalët vijnë nga HTML-ja, jo nga skripti: përkthimi rri i vetëm te i18n.
    const shto = document.body.dataset.wishAdd ?? '';
    const hiq = document.body.dataset.wishRemove ?? '';

    const vizato = (b: HTMLButtonElement) => {
      const ruajtur = eKa(b.dataset.wish ?? '');
      b.setAttribute('aria-pressed', String(ruajtur));

      const svg = b.querySelector('svg');
      // E mbushur kur është ruajtur — forma ndryshon, jo vetëm ngjyra.
      if (svg) svg.setAttribute('fill', ruajtur ? 'currentColor' : 'none');

      const etiketa = b.querySelector('[data-wish-label]');
      if (etiketa) etiketa.textContent = ruajtur ? hiq : shto;
    };

    for (const b of zemrat) {
      b.hidden = false;
      vizato(b);

      b.addEventListener('click', (e) => {
        // Karta e produktit është e gjitha një lidhje; pa këtë, klikimi mbi
        // zemër do të hapte edhe faqen e produktit.
        e.preventDefault();
        e.stopPropagation();
        nderro(b.dataset.wish ?? '');
      });
    }

    // Një produkt mund të jetë në dy vende të faqes njëherësh (kartë dhe
    // "të ngjashme"); të gjitha zemrat rifreskohen bashkë.
    degjo(() => {
      for (const b of zemrat) vizato(b);
    });
  }
</script>

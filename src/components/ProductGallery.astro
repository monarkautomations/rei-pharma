---
/**
 * Fotot e produktit: kryesorja, miniaturat, dhe zmadhimi me klikim.
 *
 * Rregulli 1 i projektit kërkon që përmbajtja të lexohet pa JavaScript. Ndaj
 * të gjitha fotot janë në HTML që në fillim: pa skript, vizitori i sheh të
 * gjitha (kryesoren të madhe, të tjerat si miniatura). Skripti shton vetëm
 * ndërrimin me klikim dhe dritaren e zmadhimit — të dyja zbukurime, jo kushte.
 *
 * Zmadhimi sillet ndryshe sipas pajisjes, sepse edhe pritshmëria është tjetër:
 *
 *   me mi   — fotoja zmadhohet aty ku rri kursori, si te dyqanet e mëdha.
 *             Nuk hapet asgjë; lëviz miun dhe sheh detajin.
 *   me prekje — hapet e plota mbi sfond të errët. Zmadhimi që ndjek gishtin
 *             nuk ka kuptim kur gishti e mbulon vetë foton; atje vlera është
 *             ta shohësh të tërën, jo një copë.
 *
 * Dallimi bëhet me `(hover: hover) and (pointer: fine)`, jo me gjerësinë e
 * ekranit: një laptop me ekran të vogël ka mi, dhe një tablet i madh jo.
 *
 * Dritarja është `<dialog>`, jo ishull React: nuk ka gjendje për të mbajtur,
 * dhe shfletuesi e jep vetë mbylljen me Escape dhe kthimin e fokusit.
 */
import { PRODUCT_PLACEHOLDER } from '../config/site';
import { t, type Lang } from '../lib/i18n';

interface Props {
  /** Kryesorja e para. Vjen e pastruar nga `catalog.ts`. */
  images: string[];
  name: string;
  lang: Lang;
  /** Zbritja në përqindje, nëse produkti është në ofertë dhe në gjendje. */
  discount?: number | null;
}

const { images, name, lang, discount } = Astro.props;

const kryesorja = images[0] ?? PRODUCT_PLACEHOLDER;
const isPlaceholder = kryesorja === PRODUCT_PLACEHOLDER;
const kaGaleri = images.length > 1;
---

<div class="flex flex-col gap-3">
  {/*
    Korniza e bardhë te fotot reale, bezh te placeholder-i — shih shënimin te
    ProductCard.astro. Kutia mban `id` që skripti ta gjejë pa e kërkuar me
    klasa, të cilat Tailwind-i mund t'i ndryshojë.
  */}
  <div
    class:list={[
      'relative overflow-hidden rounded-[14px]',
      isPlaceholder ? 'bg-bone' : 'bg-white',
    ]}
    data-gallery
  >
    {/*
      Butoni mbulon foton që zmadhimi të ketë zonë prekjeje sa e gjithë fotoja.
      Pa skript mbetet buton që nuk bën gjë — fotoja brenda duket njësoj.
    */}
    <button
      type="button"
      data-zoom
      class="block w-full overflow-hidden cursor-zoom-in"
      aria-label={`${t(lang, 'zoomPhoto')} — ${name}`}
    >
      <img
        src={kryesorja}
        alt={name}
        width="900"
        height="900"
        fetchpriority="high"
        decoding="async"
        data-main
        class:list={[
          'aspect-square w-full object-contain',
          isPlaceholder ? 'p-10' : 'p-8',
        ]}
      />
    </button>

    {
      discount && (
        <span class="pointer-events-none absolute top-4 left-4 rounded-full bg-gold-50 px-3 py-1.5 text-[13px] font-medium text-gold-600">
          −{discount}%
        </span>
      )
    }
  </div>

  {
    kaGaleri && (
      <ul class="flex flex-wrap gap-2" data-thumbs>
        {images.map((foto, i) => (
          <li>
            {/*
              64px, mbi kufirin 44px të rregullit 5. `aria-current` tregon cila
              është e zgjedhura; skripti e lëviz, CSS-ja e ngjyros.
            */}
            <button
              type="button"
              data-thumb={foto}
              aria-current={i === 0 ? 'true' : 'false'}
              aria-label={`${t(lang, 'photoOf')} ${i + 1}`}
              class="block h-16 w-16 overflow-hidden rounded-md border-2 border-mist bg-white p-1 transition-colors hover:border-gold-500 aria-[current=true]:border-forest-900"
            >
              <img
                src={foto}
                alt=""
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain"
              />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

{/*
  Dritarja e zmadhimit. Rri bosh derisa të hapet; `<dialog>` e mban të
  padukshme vetë, pa CSS shtesë dhe pa JavaScript.

  `<dialog>` ka `max-width`/`max-height` të vetat te shfletuesi (rreth 90%),
  dhe ato e ngushtonin foton; prandaj vihen 100% me dorë.

  Sfondi është i bardhë, jo i errët, për të njëjtën arsye si korniza e kartave:
  fotot e produkteve kanë sfond të bardhë, dhe mbi të errët dilnin si drejtkëndësh
  i bardhë i ngjitur në mes të ekranit. Mbi të bardhë produkti duket sikur noton.
*/}
<dialog
  data-lightbox
  class="m-0 h-[100dvh] max-h-[100dvh] w-screen max-w-screen bg-white p-0 backdrop:bg-white"
  aria-label={name}
>
  <div class="relative flex h-full w-full items-center justify-center p-4">
    {/*
      `h-full w-full`, jo `max-h-full max-w-full`.
      
      `max-*` vetëm zvogëlon: një foto 299x607 mbetej po aq e vogël në mes të
      ekranit, dhe zmadhimi nuk zmadhonte asgjë. Kështu fotoja rritet sa të
      mbushë ekranin, dhe `object-contain` ia ruan raportin — pa u prerë.
    */}
    <img
      data-lightbox-img
      src=""
      alt={name}
      class="h-full w-full object-contain"
    />

    <button
      type="button"
      data-close
      aria-label={t(lang, 'closePhoto')}
      class="absolute top-4 right-4 grid h-11 w-11 place-items-center rounded-full bg-forest-900 text-white transition-colors hover:bg-forest-700"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
</dialog>

<script>
  /**
   * Ndërrimi i fotos dhe zmadhimi.
   *
   * Nëse ky skript nuk niset, faqja mbetet e plotë: fotoja kryesore e madhe,
   * miniaturat poshtë saj, të gjitha të dukshme. Humbet vetëm ndërrimi dhe
   * dritarja e zmadhimit.
   */
  const kutia = document.querySelector<HTMLElement>('[data-gallery]');
  const kryesorja = document.querySelector<HTMLImageElement>('[data-main]');
  const dritarja = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const fotoZmadhuar = document.querySelector<HTMLImageElement>('[data-lightbox-img]');

  if (kutia && kryesorja && dritarja && fotoZmadhuar) {
    const miniaturat = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-thumb]'),
    );

    for (const b of miniaturat) {
      b.addEventListener('click', () => {
        const foto = b.dataset.thumb;
        if (!foto || foto === kryesorja.getAttribute('src')) return;
        kryesorja.src = foto;
        for (const tjetra of miniaturat) {
          tjetra.setAttribute('aria-current', String(tjetra === b));
        }
      });
    }

    const butoniZmadhimit = document.querySelector<HTMLElement>('[data-zoom]');

    /**
     * Me mi: fotoja rritet dy herë dhe ndjek kursorin.
     *
     * `transform-origin` vihet te pika ku rri kursori, ndaj ajo pikë mbetet në
     * vend ndërsa pjesa tjetër zgjerohet — përshtypja është e një xhami zmadhues.
     * Butoni ka `overflow-hidden`, ndaj ajo që del jashtë kornizës pritet.
     *
     * Pa tranzicion me qëllim: një `transition` e bën të ngecur pas kursorit.
     */
    const meMi = window.matchMedia('(hover: hover) and (pointer: fine)');

    if (butoniZmadhimit && meMi.matches) {
      butoniZmadhimit.addEventListener('mousemove', (e) => {
        const r = butoniZmadhimit.getBoundingClientRect();
        const x = ((e.clientX - r.left) / r.width) * 100;
        const y = ((e.clientY - r.top) / r.height) * 100;
        kryesorja.style.transformOrigin = `${x}% ${y}%`;
        kryesorja.style.transform = 'scale(2)';
      });

      butoniZmadhimit.addEventListener('mouseleave', () => {
        kryesorja.style.transform = '';
        kryesorja.style.transformOrigin = '';
      });
    }

    // Klikimi hap gjithmonë foton e plotë — edhe me mi, sepse xhami zmadhues
    // tregon një copë, ndërsa dikush mund ta dojë të tërën.
    // `showModal` e mbyll vetë faqen prapa dhe e kthen fokusin kur mbyllet.
    butoniZmadhimit?.addEventListener('click', () => {
      fotoZmadhuar.src = kryesorja.currentSrc || kryesorja.src;
      // Zmadhimi me mi hiqet, që fotoja të mos mbetet e rritur prapa dritares.
      kryesorja.style.transform = '';
      kryesorja.style.transformOrigin = '';
      dritarja.showModal();
    });

    document.querySelector('[data-close]')?.addEventListener('click', () => {
      dritarja.close();
    });

    // Klikimi jashtë fotos mbyll — sjellje që e pret kushdo nga një zmadhim.
    dritarja.addEventListener('click', (e) => {
      if (e.target === dritarja || (e.target as HTMLElement).dataset.lightboxImg === undefined) {
        if (e.target !== fotoZmadhuar) dritarja.close();
      }
    });
  }
</script>

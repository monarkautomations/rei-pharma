---
import Base from '../../layouts/Base.astro';
import { site, waLink } from '../../config/site';
import { t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;

const tel = `tel:${site.phone.replace(/\s/g, '')}`;
const ask = lang === 'en' ? 'Hello! I have a question.' : 'Përshëndetje! Kam një pyetje.';

const meta = {
  sq: {
    title: 'Kontakt — Rei Pharma, Rruga Albanopoli',
    description:
      'Adresa, orari dhe numri i telefonit të Farmaci Rei në Rrugën Albanopoli, Tiranë.',
  },
  en: {
    title: 'Contact — Rei Pharma, Rruga Albanopoli',
    description:
      'Address, opening hours and phone number of Farmaci Rei on Rruga Albanopoli, Tirana.',
  },
}[lang];

const ways = [
  {
    title: 'WhatsApp',
    note: t(lang, 'whatsappNote'),
    action: t(lang, 'writeOnWhatsApp'),
    href: waLink(ask),
    external: true,
    icon: 'M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2.05 22l5.3-1.38a9.87 9.87 0 0 0 4.69 1.19c5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2z',
    filled: true,
  },
  {
    title: t(lang, 'phone'),
    note: t(lang, 'phoneNote'),
    action: site.phone,
    href: tel,
    external: false,
    icon: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z',
    filled: false,
  },
  {
    title: t(lang, 'atThePharmacy'),
    note: `${site.address.street}, ${site.address.city}. ${t(lang, 'atThePharmacyNote')}`,
    action: t(lang, 'openInMaps'),
    href: site.address.mapsUrl,
    external: true,
    icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z',
    filled: false,
  },
];
---

<Base
  title={meta.title}
  description={meta.description}
  lang={lang}
  alternates={alternates}
>
  <section class="border-b border-mist bg-gradient-to-b from-forest-50 to-white">
    <div class="mx-auto max-w-[1200px] px-4 py-12 sm:py-16">
      <p class="eyebrow">{t(lang, 'weAreHere')}</p>
      <h1 class="mt-2 text-[32px] sm:text-[46px]">{t(lang, 'contactTitle')}</h1>
      <p class="mt-3 max-w-xl text-[17px] leading-relaxed text-graphite">
        {t(lang, 'contactIntro')}
      </p>
      <div class="rule-gold mt-6 h-px w-40"></div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 py-12 sm:py-16">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        ways.map((way) => (
          <div
            data-reveal
            class="flex flex-col rounded-[14px] border border-mist bg-white p-6 transition-colors hover:border-gold-500"
          >
            <span class="grid h-12 w-12 place-items-center rounded-full bg-gold-50">
              <svg
                width="21"
                height="21"
                viewBox="0 0 24 24"
                fill={way.filled ? 'var(--color-gold-600)' : 'none'}
                stroke={way.filled ? 'none' : 'var(--color-gold-600)'}
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={way.icon} />
              </svg>
            </span>

            <h2 class="mt-4 text-[22px]">{way.title}</h2>
            <p class="mt-2 flex-1 text-[15px] leading-relaxed text-graphite">
              {way.note}
            </p>

            <a
              href={way.href}
              target={way.external ? '_blank' : undefined}
              rel={way.external ? 'noopener' : undefined}
              class="mt-5 inline-flex min-h-[48px] items-center justify-center rounded-full bg-forest-900 px-6 text-[15px] font-medium text-white transition-colors hover:bg-forest-700"
            >
              {way.action}
            </a>
          </div>
        ))
      }
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_1.25fr] lg:gap-14">
      <div data-reveal>
        <h2 class="text-[26px]">{t(lang, 'hours')}</h2>
        <dl class="mt-5 text-[16px]">
          {
            site.hours.map((h) => (
              <div class="flex justify-between gap-6 border-b border-mist py-3">
                <dt class="text-graphite">{h.days[lang]}</dt>
                <dd class="tabular-nums">{h.open} – {h.close}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-8 rounded-[14px] bg-bone p-5">
          <h3 class="font-sans text-[15px] font-medium">
            {t(lang, 'prescriptionTitle')}
          </h3>
          <p class="mt-1.5 text-[14px] leading-relaxed text-graphite">
            {t(lang, 'prescriptionText')}
          </p>
        </div>
      </div>

      <div class="overflow-hidden rounded-[14px] border border-mist" data-reveal>
        <iframe
          title={t(lang, 'mapTitle')}
          src={`https://www.google.com/maps?q=${site.address.lat},${site.address.lng}&hl=${lang}&z=17&output=embed`}
          width="100%"
          height="460"
          style="border:0; display:block"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Base>

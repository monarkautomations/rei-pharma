---
import Base from '../../layouts/Base.astro';
import ProductCard from '../ProductCard.astro';
import PriceFilter from '../PriceFilter.astro';
import CategorySelect from '../CategorySelect.astro';
import Pagination from '../Pagination.astro';
import { getCategoriesWithProducts, getOrphanProducts, type Product } from '../../lib/catalog';
import { path, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  /** Vetëm produktet e kësaj faqeje, jo i gjithë katalogu. */
  products: Product[];
  /** Sa produkte ka gjithsej te lista — numri që i tregohet vizitorit. */
  total: number;
  current: number;
  totalPages: number;
}

const { lang, alternates, products, total, current, totalPages } = Astro.props;

const categories = await getCategoriesWithProducts(lang);

// Vetëm për të njoftuar në terminal nëse një kategori u fshi me produkte brenda.
await getOrphanProducts(lang);

const meta = {
  sq: {
    title: 'Të gjitha produktet — Rei Pharma',
    description:
      'Kremra dielli, vitamina, suplemente dhe produkte për flokët. Porosit online dhe paguaj në dorëzim.',
  },
  en: {
    title: 'All products — Rei Pharma',
    description:
      'Sunscreens, vitamins, supplements and hair care products. Order online and pay on delivery.',
  },
}[lang];

// Faqja 2 e tutje merr titullin e vet, që Google të mos shohë dhjetëra faqe me
// të njëjtin titull dhe të njëjtin përshkrim.
const title =
  current > 1
    ? `${meta.title.replace(' — Rei Pharma', '')} — ${t(lang, 'pageOf').replace(':n', String(current)).replace(':sa', String(totalPages))} — Rei Pharma`
    : meta.title;
---

<Base
  title={title}
  description={meta.description}
  lang={lang}
  alternates={alternates}
>
  <section class="mx-auto max-w-[1200px] px-4 py-10 sm:py-14">
    <h1 class="text-[30px] sm:text-[40px]">{t(lang, 'productsTitle')}</h1>
    {/*
      `data-product-count` e lejon filtrin e çmimit ta rifreskojë numrin.
      Fjala rri te `data-*`, jo e ngurtë te skripti, që përkthimi të mbetet i
      vetëm te i18n.
    */}
    <p
      class="mt-2 text-[16px] text-graphite"
      data-product-count
      data-one={t(lang, 'productsAvailable')}
      data-many={t(lang, 'productsAvailable')}
    >
      {total} {t(lang, 'productsAvailable')}
    </p>

    {
      categories.length > 0 && (
        <CategorySelect lang={lang} categories={categories} current={null} />
      )
    }

    {/*
      Filtri vepron mbi kartat e kësaj faqeje — ato janë kartat që ekzistojnë
      në HTML. Prandaj edhe numrat pranë intervaleve llogariten nga kjo faqe,
      jo nga i gjithë katalogu: një numër që s'i përgjigjet asaj që sheh
      vizitori pas zgjedhjes do të ishte gënjeshtër e vogël por e sigurt.
    */}
    <PriceFilter prices={products.map((p) => p.price)} lang={lang} />

    <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {
        products.map((p, i) => (
          <ProductCard
            id={p.slug}
            name={p.name}
            price={p.price}
            oldPrice={p.oldPrice}
            image={p.image}
            desc={p.desc}
            brand={p.brand}
            inStock={p.inStock}
            lang={lang}
            eager={i < 4}
          />
        ))
      }
    </div>

    <Pagination
      lang={lang}
      current={current}
      total={totalPages}
      base={path(lang, 'products')}
    />
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import HeroFlourish from '../HeroFlourish.astro';
import ProductCard from '../ProductCard.astro';
import PostCard from '../PostCard.astro';
import TrustStrip from '../TrustStrip.astro';
import StatsCounter from '../StatsCounter.astro';
import AuroraBackground from '../AuroraBackground.astro';
import CoverImage from '../CoverImage.astro';
import { site, waLink } from '../../config/site';
import { getProducts, getCategoriesWithProducts, getPosts } from '../../lib/catalog';
import { path, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;

const featured = (await getProducts(lang))
  .filter((p) => p.featured && p.inStock)
  .slice(0, 4);

const categories = await getCategoriesWithProducts(lang);
const posts = (await getPosts(lang)).slice(0, 3);

const meta = {
  sq: {
    title: `${site.brandName} — Farmaci në Tiranë | Porosit online`,
    description:
      'Kremra dielli, vitamina, suplemente dhe kujdes për flokët. Porosit online nga Farmaci Rei në Rrugën Albanopoli, Tiranë. Paguaj në dorëzim.',
    ask: 'Përshëndetje! Kam një pyetje për një produkt.',
  },
  en: {
    title: `${site.brandName} — Pharmacy in Tirana | Order online`,
    description:
      'Sunscreens, vitamins, supplements and hair care. Order online from Farmaci Rei on Rruga Albanopoli, Tirana. Pay on delivery.',
    ask: 'Hello! I have a question about a product.',
  },
}[lang];
---

<Base
  title={meta.title}
  description={meta.description}
  lang={lang}
  alternates={alternates}
>
  <!-- ============================ HERO ============================ -->
  <!--
    Foto e vitrinës u hoq me kërkesë të klientit. Sfondi tani është aurora me
    ngjyrat e logos. Fotoja mbetet e përdorur te seksioni "Na gjen këtu",
    te `og:image` dhe te schema — Google-it i duhet një foto e vërtetë.
  -->
  <section class="relative isolate overflow-hidden">
    <AuroraBackground class="-z-10" />

    <!--
      Hije mbi aurorën, jo dekor: njollat lëvizin, ndaj sfondi nën tekstin
      ndryshon vazhdimisht. Pa këtë, kontrasti do të ishte i mirë në një çast
      dhe i dobët në një tjetër. Aurora mbetet e dukshme djathtas.
    -->
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-forest-950/80 via-forest-950/30 to-transparent
             md:bg-gradient-to-r md:from-forest-950/72 md:via-forest-950/18 md:to-transparent"
    >
    </div>

    <!--
      Dikur teksti rrinte poshtë (`items-end` me `pt-36`), që të mos mbulonte
      vitrinën në foto. Pa foto ajo hapësirë nuk ka kuptim — teksti tani rri në
      qendër dhe hero-ja fillon menjëherë poshtë navbar-it.
    -->
    <div
      class="mx-auto flex min-h-[460px] max-w-[1200px] items-center px-4 py-12 sm:min-h-[520px] md:min-h-[620px] md:py-24"
    >
      <div class="max-w-[580px]">
        <p class="text-[13px] font-medium tracking-[0.16em] text-gold-300 uppercase">
          {t(lang, 'heroEyebrow')}
        </p>

        <h1 class="mt-4 text-[40px] leading-[1.06] text-white sm:text-[56px]">
          {t(lang, 'heroTitleA')}<br />{t(lang, 'heroTitleB')}
        </h1>

        <HeroFlourish width={230} tone="dark" />

        <p class="mt-6 max-w-md text-[17px] leading-relaxed text-white/85 sm:text-[18px]">
          {t(lang, 'heroText')}
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={path(lang, 'products')}
            class="inline-flex min-h-[54px] items-center justify-center rounded-full bg-gold-500 px-8 text-[16px] font-medium text-forest-950 transition-colors hover:bg-gold-400"
          >
            {t(lang, 'seeProducts')}
          </a>
          <a
            href={waLink(meta.ask)}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-[54px] items-center justify-center gap-2 rounded-full border border-white/35 px-8 text-[16px] font-medium text-white transition-colors hover:bg-white/10"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2.05 22l5.3-1.38a9.87 9.87 0 0 0 4.69 1.19c5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2z"/>
            </svg>
            {t(lang, 'askPharmacist')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip lang={lang} />

  <!-- ======================== TË ZGJEDHURA ======================== -->
  {
    featured.length > 0 && (
      <section class="mx-auto max-w-[1200px] px-4 pt-16 sm:pt-24">
        <div class="flex items-end justify-between gap-4" data-reveal>
          <div>
            <p class="eyebrow">{t(lang, 'pickedByPharmacists')}</p>
            <h2 class="mt-2 text-[30px] sm:text-[40px]">{t(lang, 'featured')}</h2>
          </div>
          <a
            href={path(lang, 'products')}
            class="shrink-0 pb-1 text-[15px] font-medium text-gold-600 hover:text-forest-900"
          >
            {t(lang, 'seeAll')} →
          </a>
        </div>

        <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
          {featured.map((p) => (
            <div data-reveal>
              <ProductCard
                id={p.slug}
                name={p.name}
                price={p.price}
                oldPrice={p.oldPrice}
                image={p.image}
                desc={p.desc}
                brand={p.brand}
                inStock={p.inStock}
                lang={lang}
              />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ========================= KATEGORITË ========================= -->
  <section class="mx-auto max-w-[1200px] px-4 py-16 sm:py-24">
    <div class="max-w-xl" data-reveal>
      <p class="eyebrow">{t(lang, 'whatWeStock')}</p>
      <h2 class="mt-2 text-[30px] sm:text-[40px]">{t(lang, 'shopByCategory')}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-graphite">
        {t(lang, 'categoryIntro')}
      </p>
    </div>

    <div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((c) => (
          <a
            href={path(lang, 'category', c.slug)}
            data-reveal
            class="group relative flex flex-col overflow-hidden rounded-[14px] border border-mist bg-white transition-all hover:border-gold-500 hover:shadow-[0_18px_40px_-24px_rgba(18,43,37,0.35)]"
          >
            {
              c.image && (
                <CoverImage
                  src={c.image}
                  alt=""
                  class="aspect-[16/9]"
                  width={480}
                  height={270}
                />
              )
            }

            <div class="relative flex flex-1 flex-col p-7">
              {
                !c.image && (
                  <span
                    class="pointer-events-none absolute -top-14 -right-14 h-32 w-32 rounded-full bg-gold-50 opacity-0 transition-opacity group-hover:opacity-100"
                    aria-hidden="true"
                  />
                )
              }

              <h3 class="relative text-[23px] text-forest-900">{c.name}</h3>
              <p class="relative mt-2 flex-1 text-[15px] leading-relaxed text-graphite">
                {c.blurb}
              </p>
              <span class="relative mt-6 inline-flex items-center gap-1.5 text-[14px] font-medium text-gold-600">
                {c.count} {t(lang, 'productsCount')}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <StatsCounter />

  <!-- =========================== BLOGU =========================== -->
  {
    posts.length > 0 && (
      <section class="mx-auto max-w-[1200px] px-4 py-16 sm:py-24">
        <div class="flex items-end justify-between gap-4" data-reveal>
          <div>
            <p class="eyebrow">{t(lang, 'blogEyebrow')}</p>
            <h2 class="mt-2 text-[30px] sm:text-[40px]">{t(lang, 'blogTitle')}</h2>
          </div>
          <a
            href={path(lang, 'blog')}
            class="shrink-0 pb-1 text-[15px] font-medium text-gold-600 hover:text-forest-900"
          >
            {t(lang, 'seeAll')} →
          </a>
        </div>

        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((p) => (
            <div data-reveal>
              <PostCard
                slug={p.id}
                title={p.data.title}
                excerpt={p.data.excerpt}
                cover={p.data.cover}
                coverAlt={p.data.coverAlt}
                tag={p.data.tag}
                date={p.data.date}
                lang={lang}
              />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ======================== VIZITA / CTA ======================== -->
  <section class="border-t border-mist bg-cream">
    <div class="mx-auto max-w-[1200px] px-4 py-16 sm:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div data-reveal>
          <p class="eyebrow">{t(lang, 'findUsHere')}</p>
          <h2 class="mt-2 text-[30px] sm:text-[40px]">{t(lang, 'orVisit')}</h2>
          <p class="mt-4 text-[17px] leading-relaxed text-graphite">
            {site.address.street}, {site.address.city}. {t(lang, 'orVisitText')}
          </p>

          <dl class="mt-7 space-y-3 text-[15px]">
            {site.hours.map((h) => (
              <div class="flex justify-between gap-6 border-b border-mist pb-3 sm:max-w-sm">
                <dt class="text-graphite">{h.days[lang]}</dt>
                <dd class="tabular-nums text-forest-900">{h.open} – {h.close}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={`tel:${site.phone.replace(/\s/g, '')}`}
              class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-forest-900 px-7 text-[15px] font-medium text-white transition-colors hover:bg-forest-700"
            >
              {t(lang, 'contactUs')}
            </a>
            <a
              href={site.address.mapsUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-forest-900/20 px-7 text-[15px] font-medium transition-colors hover:bg-white"
            >
              {t(lang, 'openInMaps')}
            </a>
          </div>
        </div>

        <div class="overflow-hidden rounded-[14px] border border-mist" data-reveal>
          <img
            src="/hero-wide-1000.webp"
            alt="Farmaci Rei, Rruga Albanopoli"
            width="1000"
            height="563"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover lg:aspect-[3/2]"
          />
        </div>
      </div>
    </div>
  </section>
</Base>

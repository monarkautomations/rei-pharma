---
import Base from '../../layouts/Base.astro';
import ProductCard from '../ProductCard.astro';
import PriceFilter from '../PriceFilter.astro';
import CategorySelect from '../CategorySelect.astro';
import Pagination from '../Pagination.astro';
import type { Category, Product } from '../../lib/catalog';
import { path, t, type Lang } from '../../lib/i18n';
import { pageTitle } from '../../lib/seo';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  category: Category;
  /** Vetëm produktet e kësaj faqeje. */
  products: Product[];
  /** Të gjitha kategoritë, kjo përfshirë — zgjedhësi i tregon të plota. */
  categories: Category[];
  current: number;
  totalPages: number;
}

const { lang, alternates, category, products, categories, current, totalPages } = Astro.props;

// Faqja 2 e tutje merr titull të vetin, që të mos dalin dhjetëra faqe me të
// njëjtin titull te Google.
const titulli =
  current > 1
    ? pageTitle(
        `${category.name} — ${t(lang, 'pageOf').replace(':n', String(current)).replace(':sa', String(totalPages))}`,
        'Rei Pharma',
      )
    : pageTitle(category.name, 'Rei Pharma');
---

<Base
  title={titulli}
  description={category.blurb}
  lang={lang}
  alternates={alternates}
>
  <section class="mx-auto max-w-[1200px] px-4 py-10 sm:py-14">
    <nav class="text-[14px] text-slate" aria-label={t(lang, 'breadcrumb')}>
      <a href={path(lang, 'home')} class="hover:text-forest-900">{t(lang, 'home')}</a>
      <span class="px-1.5">/</span>
      <a href={path(lang, 'products')} class="hover:text-forest-900">
        {t(lang, 'productsTitle')}
      </a>
    </nav>

    <h1 class="mt-3 text-[30px] sm:text-[40px]">{category.name}</h1>
    <p class="mt-2 max-w-xl text-[16px] leading-relaxed text-graphite">
      {category.blurb}
    </p>

    <CategorySelect lang={lang} categories={categories} current={category.slug} />

    {
      products.length === 0 ? (
        <div class="mt-10 rounded-[14px] border border-mist p-8 text-center">
          <p class="text-[16px] text-graphite">{t(lang, 'emptyCategory')}</p>
          <a
            href={path(lang, 'products')}
            class="mt-4 inline-flex min-h-[46px] items-center rounded-full border border-forest-900/20 px-6 text-[15px] font-medium"
          >
            {t(lang, 'seeAllProducts')}
          </a>
        </div>
      ) : (
        <>
        <PriceFilter prices={products.map((p) => p.price)} lang={lang} />

        <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
          {products.map((p, i) => (
            <ProductCard
              id={p.slug}
              name={p.name}
              price={p.price}
              oldPrice={p.oldPrice}
              image={p.image}
              desc={p.desc}
              brand={p.brand}
              inStock={p.inStock}
              lang={lang}
              eager={i < 4}
            />
          ))}
        </div>

        <Pagination
          lang={lang}
          current={current}
          total={totalPages}
          base={path(lang, 'category', category.slug)}
        />
        </>
      )
    }
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import ProductCard from '../ProductCard.astro';
import CoverImage from '../CoverImage.astro';
import type { Category, Product } from '../../lib/catalog';
import { path, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  category: Category;
  products: Product[];
  siblings: Category[];
}

const { lang, alternates, category, products, siblings } = Astro.props;
---

<Base
  title={`${category.name} — Rei Pharma`}
  description={category.blurb}
  lang={lang}
  image={category.image}
  alternates={alternates}
>
  {
    category.image && (
      <div class="mx-auto max-w-[1200px] px-4 pt-8 sm:pt-10">
        <CoverImage
          src={category.image}
          alt=""
          class="aspect-[21/9] rounded-[14px]"
          eager
          width={1200}
          height={514}
        />
      </div>
    )
  }

  <section class="mx-auto max-w-[1200px] px-4 py-10 sm:py-14">
    <nav class="text-[14px] text-slate" aria-label={t(lang, 'breadcrumb')}>
      <a href={path(lang, 'home')} class="hover:text-forest-900">{t(lang, 'home')}</a>
      <span class="px-1.5">/</span>
      <a href={path(lang, 'products')} class="hover:text-forest-900">
        {t(lang, 'productsTitle')}
      </a>
    </nav>

    <h1 class="mt-3 text-[30px] sm:text-[40px]">{category.name}</h1>
    <p class="mt-2 max-w-xl text-[16px] leading-relaxed text-graphite">
      {category.blurb}
    </p>

    <nav class="mt-6 flex flex-wrap gap-2" aria-label={t(lang, 'filterByCategory')}>
      <a
        href={path(lang, 'products')}
        class="inline-flex min-h-[44px] items-center rounded-full border border-mist px-5 text-[14px] text-forest-900 transition-colors hover:border-gold-500"
      >
        {t(lang, 'allProducts')}
      </a>
      <span
        class="inline-flex min-h-[44px] items-center rounded-full bg-forest-900 px-5 text-[14px] text-white"
        aria-current="page"
      >
        {category.name}
      </span>
      {
        siblings.map((s) => (
          <a
            href={path(lang, 'category', s.slug)}
            class="inline-flex min-h-[44px] items-center rounded-full border border-mist px-5 text-[14px] text-forest-900 transition-colors hover:border-gold-500"
          >
            {s.name}
          </a>
        ))
      }
    </nav>

    {
      products.length === 0 ? (
        <div class="mt-10 rounded-[14px] border border-mist p-8 text-center">
          <p class="text-[16px] text-graphite">{t(lang, 'emptyCategory')}</p>
          <a
            href={path(lang, 'products')}
            class="mt-4 inline-flex min-h-[46px] items-center rounded-full border border-forest-900/20 px-6 text-[15px] font-medium"
          >
            {t(lang, 'seeAllProducts')}
          </a>
        </div>
      ) : (
        <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
          {products.map((p, i) => (
            <ProductCard
              id={p.slug}
              name={p.name}
              price={p.price}
              oldPrice={p.oldPrice}
              image={p.image}
              desc={p.desc}
              brand={p.brand}
              inStock={p.inStock}
              lang={lang}
              eager={i < 4}
            />
          ))}
        </div>
      )
    }
  </section>
</Base>

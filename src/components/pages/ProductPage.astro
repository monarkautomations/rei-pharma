---
import Base from '../../layouts/Base.astro';
import ProductCard from '../ProductCard.astro';
import AddToCart from '../AddToCart';
import { site, formatPrice, waLink } from '../../config/site';
import type { Category, Product } from '../../lib/catalog';
import { path, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  product: Product;
  category: Category | null;
  related: Product[];
}

const { lang, alternates, product, category, related } = Astro.props;

const url = new URL(path(lang, 'product', product.slug), Astro.site).href;
const hasRealBrand = Boolean(product.brand && product.brand !== 'PLACEHOLDER');
const isPlaceholder = product.image === '/produkt-placeholder.svg';

// Google dhe rrjetet sociale nuk e pranojnë SVG-në si foto produkti. Derisa
// klienti të dërgojë fotot reale, përdoret vitrina e farmacisë.
const shareImage = isPlaceholder ? '/hero-wide-1600.webp' : product.image;
const imageUrl = new URL(shareImage, Astro.site).href;

const discount =
  product.oldPrice && product.oldPrice > product.price
    ? Math.round((1 - product.price / product.oldPrice) * 100)
    : null;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.desc,
  image: imageUrl,
  url,
  sku: product.slug,
  ...(hasRealBrand ? { brand: { '@type': 'Brand', name: product.brand } } : {}),
  ...(category ? { category: category.name } : {}),
  offers: {
    '@type': 'Offer',
    price: product.price,
    priceCurrency: 'ALL',
    url,
    availability: product.inStock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    seller: { '@type': 'Pharmacy', name: site.legalName },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: t(lang, 'home'), item: new URL(path(lang, 'home'), Astro.site).href },
    {
      name: t(lang, 'productsTitle'),
      item: new URL(path(lang, 'products'), Astro.site).href,
    },
    ...(category
      ? [
          {
            name: category.name,
            item: new URL(path(lang, 'category', category.slug), Astro.site).href,
          },
        ]
      : []),
    { name: product.name, item: url },
  ].map((entry, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: entry.name,
    item: entry.item,
  })),
};

const tail =
  lang === 'en'
    ? `. Order online from ${site.legalName} in Tirana, pay on delivery.`
    : `. Porosit online nga ${site.legalName} në Tiranë, paguaj në dorëzim.`;

const metaDescription = `${product.desc} ${formatPrice(product.price)}${tail}`.slice(0, 300);

const askMessage =
  lang === 'en'
    ? `Hello! I have a question about "${product.name}".`
    : `Përshëndetje! Kam një pyetje për "${product.name}".`;
---

<Base
  title={`${product.name} — ${site.brandName}`}
  description={metaDescription}
  lang={lang}
  image={shareImage}
  schemas={[productSchema, breadcrumbSchema]}
  alternates={alternates}
>
  <div class="mx-auto max-w-[1200px] px-4 py-6 sm:py-10">
    <nav class="text-[14px] text-slate" aria-label={t(lang, 'breadcrumb')}>
      <a href={path(lang, 'home')} class="hover:text-forest-900">{t(lang, 'home')}</a>
      <span class="px-1.5">/</span>
      <a href={path(lang, 'products')} class="hover:text-forest-900">
        {t(lang, 'productsTitle')}
      </a>
      {
        category && (
          <>
            <span class="px-1.5">/</span>
            <a
              href={path(lang, 'category', category.slug)}
              class="hover:text-forest-900"
            >
              {category.name}
            </a>
          </>
        )
      }
    </nav>

    <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-14">
      <div class="relative overflow-hidden rounded-[14px] bg-bone">
        <img
          src={product.image}
          alt={product.name}
          width="900"
          height="1200"
          fetchpriority="high"
          decoding="async"
          class:list={[
            'aspect-square w-full lg:aspect-[3/4]',
            // Asnjë foto nuk pritet — shih shënimin te ProductCard.astro.
            'object-contain',
            isPlaceholder ? 'p-10' : 'p-6',
          ]}
        />
        {
          discount && product.inStock && (
            <span class="absolute top-4 left-4 rounded-full bg-gold-50 px-3 py-1.5 text-[13px] font-medium text-gold-600">
              −{discount}%
            </span>
          )
        }
      </div>

      <div class="lg:py-4">
        {
          hasRealBrand && (
            <p class="font-sans text-[13px] font-medium tracking-[0.14em] text-gold-600 uppercase">
              {product.brand}
            </p>
          )
        }

        <h1 class="mt-1 text-[28px] leading-tight sm:text-[38px]">
          {product.name}
        </h1>

        <div class="mt-5 flex items-baseline gap-3">
          <span class="text-[30px] font-medium tabular-nums text-forest-900">
            {formatPrice(product.price)}
          </span>
          {
            product.oldPrice && (
              <span class="text-[18px] tabular-nums text-slate line-through">
                {formatPrice(product.oldPrice)}
              </span>
            )
          }
        </div>

        <p class="mt-2 flex items-center gap-2 text-[14px]">
          <span
            class:list={[
              'inline-block h-2 w-2 rounded-full',
              product.inStock ? 'bg-forest-500' : 'bg-slate',
            ]}
            aria-hidden="true"
          ></span>
          <span class={product.inStock ? 'text-forest-500' : 'text-slate'}>
            {product.inStock ? t(lang, 'inStock') : t(lang, 'outOfStock')}
          </span>
        </p>

        <p class="mt-6 text-[17px] leading-relaxed text-graphite">
          {product.desc}
        </p>

        <div class="mt-7 max-w-sm">
          <AddToCart
            client:load
            id={product.slug}
            name={product.name}
            price={product.price}
            image={product.image}
            inStock={product.inStock}
            lang={lang}
          />
        </div>

        <a
          href={waLink(askMessage)}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex w-full min-h-[46px] max-w-sm items-center justify-center rounded-full border border-forest-900/20 px-6 text-[15px] font-medium transition-colors hover:bg-bone"
        >
          {t(lang, 'askAboutProduct')}
        </a>

        <dl class="mt-8 space-y-3 border-t border-mist pt-6 text-[15px]">
          {
            hasRealBrand && (
              <div class="flex gap-4">
                <dt class="w-28 shrink-0 text-slate">{t(lang, 'brand')}</dt>
                <dd>{product.brand}</dd>
              </div>
            )
          }
          {
            category && (
              <div class="flex gap-4">
                <dt class="w-28 shrink-0 text-slate">{t(lang, 'category')}</dt>
                <dd>
                  <a
                    href={path(lang, 'category', category.slug)}
                    class="text-gold-600 underline underline-offset-2 hover:text-forest-900"
                  >
                    {category.name}
                  </a>
                </dd>
              </div>
            )
          }
          <div class="flex gap-4">
            <dt class="w-28 shrink-0 text-slate">{t(lang, 'payment')}</dt>
            <dd>{t(lang, 'cashOnDelivery')}</dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-28 shrink-0 text-slate">{t(lang, 'delivery')}</dt>
            <dd>{t(lang, 'deliveryNote')}</dd>
          </div>
        </dl>

        <p class="mt-6 rounded-md bg-bone p-4 text-[13px] leading-relaxed text-graphite">
          {t(lang, 'productDisclaimer')}
        </p>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-16 sm:mt-24">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-[26px] sm:text-[32px]">{t(lang, 'related')}</h2>
            {category && (
              <a
                href={path(lang, 'category', category.slug)}
                class="shrink-0 text-[15px] font-medium text-gold-600 hover:text-forest-900"
              >
                {t(lang, 'seeAll')}
              </a>
            )}
          </div>

          <div class="mt-7 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
            {related.map((r) => (
              <ProductCard
                id={r.slug}
                name={r.name}
                price={r.price}
                oldPrice={r.oldPrice}
                image={r.image}
                desc={r.desc}
                brand={r.brand}
                inStock={r.inStock}
                lang={lang}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

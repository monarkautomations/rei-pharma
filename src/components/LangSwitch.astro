---
import { LANGS, langName, t, type Lang } from '../lib/i18n';

/**
 * Ndërruesi i gjuhës.
 *
 * Çdo gjuhë është një link i vërtetë drejt së njëjtës faqe në gjuhën tjetër —
 * jo një buton që rimbush përkthimet me JavaScript. Kështu Google e sheh
 * lidhjen, dhe adresa e kopjuar e mban gjuhën.
 */
interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  tone?: 'light' | 'dark';
}

const { lang, alternates, tone = 'light' } = Astro.props;

const active =
  tone === 'dark' ? 'bg-white/15 text-white' : 'bg-forest-900 text-white';
const idle =
  tone === 'dark'
    ? 'text-bone/70 hover:text-white'
    : 'text-graphite hover:text-forest-900';
---

<nav
  aria-label={t(lang, 'changeLanguage')}
  class:list={[
    'flex items-center gap-0.5 rounded-full p-0.5',
    tone === 'dark' ? '' : 'border border-mist',
  ]}
>
  {
    LANGS.map((code) => (
      <a
        href={alternates[code]}
        hreflang={code}
        lang={code}
        aria-current={code === lang ? 'true' : undefined}
        class:list={[
          'inline-flex items-center justify-center rounded-full px-3 text-[13px] font-medium transition-colors',
          tone === 'dark' ? 'h-6' : 'h-10 flex-1',
          code === lang ? active : idle,
        ]}
      >
        {code === 'sq' ? 'SQ' : 'EN'}
        <span class="sr-only"> — {langName[code]}</span>
      </a>
    ))
  }
</nav>

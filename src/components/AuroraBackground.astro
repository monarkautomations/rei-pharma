---
/**
 * Sfond aurora për hero-n — vetëm CSS, zero JavaScript.
 *
 * Origjinali që na u dërgua ishte komponent React me `framer-motion`. Nuk u
 * përdor ashtu me qëllim: hero-ja mban `<h1>`-in, dhe një ishull React do ta
 * bënte titullin të varej nga skripti, plus ~50KB JavaScript për një sfond
 * dekorativ. Rregullat 1 dhe 3 te CLAUDE.md e ndalojnë.
 *
 * Yjet gjenerohen në build me një gjenerator me farë fikse — pra HTML-ja del
 * e njëjtë çdo herë, pa dridhje mes serverit dhe klientit.
 */
interface Props {
  /** Sa pika drite. 0 i heq fare. */
  stars?: number;
  class?: string;
}

const { stars = 46, class: className = '' } = Astro.props;

// Gjenerator i thjeshtë me farë: pa të, çdo build do të nxirrte yje në vende
// të tjera dhe diff-i i git-it do të ishte plot zhurmë.
function seeded(seed: number) {
  let state = seed;
  return () => {
    state = (state * 1103515245 + 12345) % 2147483648;
    return state / 2147483648;
  };
}

const random = seeded(20260903);

const points = Array.from({ length: stars }, () => ({
  left: (random() * 100).toFixed(2),
  top: (random() * 100).toFixed(2),
  size: (random() * 1.6 + 0.8).toFixed(2),
  delay: (random() * 6).toFixed(2),
  duration: (random() * 3 + 2.5).toFixed(2),
  peak: (random() * 0.55 + 0.25).toFixed(2),
}));
---

<div class:list={['aurora', className]} aria-hidden="true">
  <div class="aurora-base"></div>

  <!-- Njollat e ngjyrës. Jeshile e thellë me ar, marrë nga logoja. -->
  <div class="blob blob-forest"></div>
  <div class="blob blob-gold"></div>
  <div class="blob blob-deep"></div>

  <!-- Rrjeta e shkëlqimit që merr frymë ngadalë. -->
  <div class="glow"></div>

  {
    points.map((p) => (
      <span
        class="star"
        style={`left:${p.left}%; top:${p.top}%; width:${p.size}px; height:${p.size}px;
                --star-delay:${p.delay}s; --star-duration:${p.duration}s; --star-peak:${p.peak};`}
      />
    ))
  }

  <!-- Kalimi te seksioni pasardhës, që buza të mos jetë e prerë. -->
  <div class="fade"></div>
</div>

<style>
  .aurora {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-forest-950);
  }

  .aurora-base {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        120% 80% at 15% 0%,
        color-mix(in oklab, var(--color-forest-700) 85%, transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        90% 70% at 85% 100%,
        color-mix(in oklab, var(--color-forest-800) 90%, transparent) 0%,
        transparent 65%
      );
  }

  .blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    will-change: transform;
  }

  .blob-forest {
    top: -18%;
    left: -12%;
    width: 62%;
    height: 68%;
    background: var(--color-forest-500);
    opacity: 0.42;
    animation: drift-a 34s ease-in-out infinite alternate;
  }

  .blob-gold {
    right: -16%;
    bottom: -24%;
    width: 58%;
    height: 62%;
    background: var(--color-gold-500);
    /* Ari mbahet i zbehtë me qëllim: mbi të rri tekst i bardhë, dhe një ar i
       fortë e ha kontrastin. */
    opacity: 0.2;
    animation: drift-b 46s ease-in-out infinite alternate;
  }

  .blob-deep {
    top: 28%;
    left: 38%;
    width: 42%;
    height: 46%;
    background: var(--color-forest-700);
    opacity: 0.5;
    animation: drift-c 58s ease-in-out infinite alternate;
  }

  .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 55% at 28% 42%,
      color-mix(in oklab, var(--color-gold-300) 16%, transparent) 0%,
      transparent 70%
    );
    animation: breathe 12s ease-in-out infinite;
  }

  .star {
    position: absolute;
    border-radius: 9999px;
    background: var(--color-gold-100);
    opacity: 0;
    animation: twinkle var(--star-duration) ease-in-out var(--star-delay) infinite;
  }

  .fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 22%;
    background: linear-gradient(to top, var(--color-forest-950), transparent);
  }

  @keyframes drift-a {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(9%, 6%, 0) scale(1.18); }
  }

  @keyframes drift-b {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(-11%, -7%, 0) scale(1.24); }
  }

  @keyframes drift-c {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(-7%, 9%, 0) scale(0.88); }
  }

  @keyframes breathe {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50%      { opacity: 0.9;  transform: scale(1.06); }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0; }
    50%      { opacity: var(--star-peak); }
  }

  /* Sfondi mbetet, lëvizja jo. */
  @media (prefers-reduced-motion: reduce) {
    .blob,
    .glow,
    .star {
      animation: none;
    }

    .star {
      opacity: var(--star-peak);
    }
  }
</style>
